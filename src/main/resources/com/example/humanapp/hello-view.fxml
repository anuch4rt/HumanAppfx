<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.humanapp.HelloController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="ระบบบันทึกข้อมูลบุคลากร" />

    <GridPane alignment="CENTER" hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="35.0" />
            <RowConstraints minHeight="35.0" />
            <RowConstraints minHeight="35.0" />
            <RowConstraints minHeight="35.0" />
            <RowConstraints minHeight="35.0" />
        </rowConstraints>

        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="ประเภทข้อมูล:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="typeComboBox" prefWidth="220.0" style="-fx-pref-height: 35px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="รหัสประจำตัว:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="idField" promptText="กรอกรหัส" style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="ชื่อ:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="nameField" promptText="กรอกชื่อ" style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="นามสกุล:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="lastnameField" promptText="กรอกนามสกุล" style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label fx:id="extraLabel" style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="คะแนน (Score):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="extraField" promptText="กรอกคะแนน" style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
    </GridPane>

    <Button onAction="#onSubmitButtonClick" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 150px; -fx-pref-height: 38px; -fx-background-radius: 6px; -fx-cursor: hand;" text="บันทึกข้อมูล" />

    <Label fx:id="resultLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" wrapText="true" />

    <VBox alignment="CENTER_LEFT" spacing="5.0">
        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="รายการข้อมูลที่บันทึก:" />
        <TextArea fx:id="displayArea" editable="false" prefHeight="160.0" prefWidth="420.0" style="-fx-font-family: 'Monospaced'; -fx-font-size: 13px;" wrapText="true" />
    </VBox>
</VBox>