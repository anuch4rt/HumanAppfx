<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.humanapp.HelloController"
      style="-fx-background-color: #f8f9fa;">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- หัวข้อระบบ -->
    <Label text="ระบบบันทึกข้อมูลนักศึกษา"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <!-- ฟอร์มกรอกข้อมูล -->
    <GridPane alignment="CENTER" hgap="12" vgap="15">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="35.0" />
            <RowConstraints minHeight="35.0" />
            <RowConstraints minHeight="35.0" />
        </rowConstraints>

        <!-- รหัสนักศึกษา -->
        <Label text="รหัสนักศึกษา:" GridPane.columnIndex="0" GridPane.rowIndex="0"
               style="-fx-font-size: 14px; -fx-text-fill: #34495e;" />
        <TextField fx:id="idField" promptText="กรอกรหัสนักศึกษา" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" />

        <!-- ชื่อ -->
        <Label text="ชื่อ:" GridPane.columnIndex="0" GridPane.rowIndex="1"
               style="-fx-font-size: 14px; -fx-text-fill: #34495e;" />
        <TextField fx:id="nameField" promptText="กรอกชื่อ" GridPane.columnIndex="1" GridPane.rowIndex="1"
                   style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" />

        <!-- นามสกุล -->
        <Label text="นามสกุล:" GridPane.columnIndex="0" GridPane.rowIndex="2"
               style="-fx-font-size: 14px; -fx-text-fill: #34495e;" />
        <TextField fx:id="lastnameField" promptText="กรอกนามสกุล" GridPane.columnIndex="1" GridPane.rowIndex="2"
                   style="-fx-pref-height: 35px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #bdc3c7;" />
    </GridPane>

    <!-- ปุ่มบันทึก -->
    <Button onAction="#onSubmitButtonClick" text="บันทึกข้อมูล"
            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 150px; -fx-pref-height: 38px; -fx-background-radius: 6px; -fx-cursor: hand;" />

    <!-- แสดงผลลัพธ์หลังจากกดปุ่ม -->
    <Label fx:id="resultLabel"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"
           wrapText="true" />
</VBox>