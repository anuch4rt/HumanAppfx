<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="0.0" style="-fx-background-color: #e0f2fe;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.humanapp.HelloController">
    <HBox alignment="CENTER" style="-fx-background-color: #0284c7; -fx-padding: 18px;">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" text="ระบบบันทึกข้อมูลบุคลากร" />
    </HBox>

    <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20px;">
        <GridPane alignment="CENTER" hgap="12" vgap="12" style="-fx-background-color: #ffffff; -fx-padding: 20px; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-border-color: #bae6fd; -fx-border-width: 1px;">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="110.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="35.0" />
                <RowConstraints minHeight="35.0" />
                <RowConstraints minHeight="35.0" />
                <RowConstraints minHeight="35.0" />
                <RowConstraints minHeight="35.0" />
            </rowConstraints>

            <Label style="-fx-font-size: 14px; -fx-text-fill: #0369a1; -fx-font-weight: bold;" text="ประเภทข้อมูล:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="typeComboBox" prefWidth="220.0" style="-fx-pref-height: 35px; -fx-background-color: #ffffff; -fx-border-color: #38bdf8; -fx-border-radius: 6px; -fx-background-radius: 6px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #0369a1; -fx-font-weight: bold;" text="รหัสประจำตัว:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="idField" promptText="กรอกรหัส" style="-fx-pref-height: 35px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #38bdf8; -fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #0369a1; -fx-font-weight: bold;" text="ชื่อ:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="nameField" promptText="กรอกชื่อ" style="-fx-pref-height: 35px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #38bdf8; -fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #0369a1; -fx-font-weight: bold;" text="นามสกุล:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="lastnameField" promptText="กรอกนามสกุล" style="-fx-pref-height: 35px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #38bdf8; -fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label fx:id="extraLabel" style="-fx-font-size: 14px; -fx-text-fill: #0369a1; -fx-font-weight: bold;" text="คะแนน (Score):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="extraField" promptText="กรอกคะแนน" style="-fx-pref-height: 35px; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-border-color: #38bdf8; -fx-background-color: #ffffff;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        </GridPane>

        <Button onAction="#onSubmitButtonClick" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 180px; -fx-pref-height: 40px; -fx-background-radius: 20px; -fx-cursor: hand;" text="บันทึกข้อมูล" />

        <Label fx:id="resultLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" wrapText="true" />

        <VBox alignment="CENTER_LEFT" spacing="6.0">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0369a1;" text="รายการข้อมูลที่บันทึก:" />
            <TextArea fx:id="displayArea" editable="false" prefHeight="150.0" prefWidth="430.0" style="-fx-font-family: 'Monospaced'; -fx-font-size: 13px; -fx-border-color: #bae6fd; -fx-border-radius: 8px; -fx-background-radius: 8px;" wrapText="true" />
        </VBox>
    </VBox>
</VBox>